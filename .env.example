# Django runtime
DJANGO_SECRET_KEY=replace-with-a-secure-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Frontend URL used by Django redirects after login/register
FRONTEND_BASE_URL=http://127.0.0.1:5500/frontend

# CORS / CSRF origins (comma separated)
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500,http://127.0.0.1:8000,http://localhost:8000
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500,http://127.0.0.1:8000,http://localhost:8000
SESSION_COOKIE_SAMESITE=Lax
