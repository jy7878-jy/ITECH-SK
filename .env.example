# Django runtime
DJANGO_SECRET_KEY=your-production-secret-key-here
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=your-backend-app.onrender.com

# Frontend URL used by Django redirects after login/register
FRONTEND_BASE_URL=https://your-github-username.github.io/ITECH-SK

# CORS / CSRF origins (comma separated)
CORS_ALLOWED_ORIGINS=https://your-github-username.github.io
CSRF_TRUSTED_ORIGINS=https://your-github-username.github.io
SESSION_COOKIE_SAMESITE=Lax